PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>
MFA_ENCRYPTION_KEY=<64-hex-characters>
CLIENT_URL=http://localhost:4200,https://<your-frontend-domain>
UPLOAD_DIR=uploads
OFFICE_START_TIME=09:30
LATE_GRACE_MINUTES=30
OFFICE_END_TIME=18:00
EARLY_CHECKOUT_GRACE_MINUTES=15
ANNUAL_LEAVE_DAYS=24
WEEKLY_HOLIDAYS=0,6
TZ=UTC
VAPID_PUBLIC_KEY=<generated-public-vapid-key>
VAPID_PRIVATE_KEY=<generated-private-vapid-key>
VAPID_SUBJECT=mailto:<admin-email>
